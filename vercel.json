{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["public/**"] }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/dashboard", "dest": "/server.js" },
    { "src": "/dashboard.html", "dest": "/server.js" },
    { "src": "/tracker", "dest": "/server.js" },
    { "src": "/tracker.html", "dest": "/server.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
